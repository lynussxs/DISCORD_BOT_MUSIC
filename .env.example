# ── Required ──────────────────────────────────────────────────────────────────

# Your bot token from https://discord.com/developers/applications
# NEVER share this token or commit it to version control.
BOT_TOKEN=your_bot_token_here

# Your server (guild) ID — REQUIRED.
# This bot uses guild-only command sync to prevent duplicate slash commands.
# Without this, the bot will refuse to start.
#
# How to find your guild ID:
#   1. Open Discord Settings → Advanced → enable Developer Mode
#   2. Right-click your server icon → Copy Server ID
DEV_GUILD_ID=your_server_id_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Default volume level for new players (0–100)
DEFAULT_VOLUME=50

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path to the rotating log file (directory is created automatically)
LOG_FILE=logs/bot.log

# ── Proxy / fallback (tất cả tuỳ chọn) ─────────────────────────────────────────
# KHÔNG ghi mật khẩu proxy vào source code — đặt ở đây / Railway Variables.
# Webshare API key: bot tự lấy danh sách proxy + credentials hiện tại.
WEBSHARE_API_KEY=
# "user:pass" dùng chung cho danh sách IP Webshare cố định trong music.py (bỏ trống nếu dùng API key)
WEBSHARE_CRED=
# Proxy Mỹ riêng: http://user:pass@host:port
PROXY_US=
# Khi YouTube chặn hết cách, tìm đúng bài (khớp tên + độ dài) trên SoundCloud. 0 = tắt.
SC_FALLBACK=1
# Piped/Invidious công khai gần như đã chết → mặc định tắt. 1 = bật lại.
PIPED_FALLBACK=0
