# ── Required ──────────────────────────────────────────────────────────────────

# Your bot token from https://discord.com/developers/applications
# NEVER share this token or commit it to version control.
BOT_TOKEN=your_bot_token_here

# Your server (guild) ID — REQUIRED.
# This bot uses guild-only command sync to prevent duplicate slash commands.
# Without this, the bot will refuse to start.
#
# How to find your guild ID:
#   1. Open Discord Settings → Advanced → enable Developer Mode
#   2. Right-click your server icon → Copy Server ID
DEV_GUILD_ID=your_server_id_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Default volume level for new players (0–100)
DEFAULT_VOLUME=50

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path to the rotating log file (directory is created automatically)
LOG_FILE=logs/bot.log
